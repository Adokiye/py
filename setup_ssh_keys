#!/usr/bin/env python3

import os
import subprocess
import time
import socket

SSH_USER = "fsalami"
SSH_KEY = os.path.expanduser("~/.ssh/id_rsa.pub")
SSH_PORT = 22
CONNECT_TIMEOUT = 10

HOSTS = [
    "ausdbedw",
    "ausdb0d",
]


def resolve(host):
    print(f"  [1/4] Resolving {host}...")
    start = time.monotonic()
    try:
        ip = socket.gethostbyname(host)
        elapsed = time.monotonic() - start
        print(f"        OK - {host} -> {ip} ({elapsed:.2f}s)")
        return ip
    except socket.gaierror as e:
        elapsed = time.monotonic() - start
        print(f"        FAIL - {e} (after {elapsed:.2f}s)")
        return None


def check_reachable(host, ip, port, timeout):
    print(f"  [2/4] Checking TCP reachability to {host} ({ip}):{port} (timeout {timeout}s)...")
    start = time.monotonic()
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            elapsed = time.monotonic() - start
            print(f"        OK - port {port} reachable in {elapsed:.2f}s")
            return True
    except (socket.timeout, OSError) as e:
        elapsed = time.monotonic() - start
        print(f"        FAIL - {e} (after {elapsed:.2f}s)")
        return False


def check_ssh_banner(ip, port, timeout):
    print(f"  [3/4] Probing SSH banner on {ip}:{port}...")
    start = time.monotonic()
    try:
        with socket.create_connection((ip, port), timeout=timeout) as s:
            s.settimeout(timeout)
            banner = s.recv(256).decode(errors="replace").strip()
            elapsed = time.monotonic() - start
            print(f"        OK - banner: {banner!r} ({elapsed:.2f}s)")
            return True
    except (socket.timeout, OSError) as e:
        elapsed = time.monotonic() - start
        print(f"        FAIL - {e} (after {elapsed:.2f}s)")
        return False


if not os.path.exists(SSH_KEY):
    print(f"ERROR: SSH public key not found at {SSH_KEY}")
    raise SystemExit(1)

print(f"Using SSH user: {SSH_USER}")
print(f"Using SSH key:  {SSH_KEY}")
print(f"Targets:        {len(HOSTS)} host(s)")

overall_start = time.monotonic()
results = []

for idx, host in enumerate(HOSTS, 1):
    print(f"\n=== [{idx}/{len(HOSTS)}] {host} ===")
    host_start = time.monotonic()

    ip = resolve(host)
    if ip is None:
        results.append((host, "-", "DNS_FAIL", time.monotonic() - host_start))
        continue

    if not check_reachable(host, ip, SSH_PORT, CONNECT_TIMEOUT):
        results.append((host, ip, "UNREACHABLE", time.monotonic() - host_start))
        continue

    if not check_ssh_banner(ip, SSH_PORT, CONNECT_TIMEOUT):
        results.append((host, ip, "NO_SSH_BANNER", time.monotonic() - host_start))
        continue

    print(f"  [4/4] Running ssh-copy-id as {SSH_USER}@{host}...")
    cmd = [
        "ssh-copy-id",
        "-o", "StrictHostKeyChecking=no",
        "-o", f"ConnectTimeout={CONNECT_TIMEOUT}",
        "-i", SSH_KEY,
        f"{SSH_USER}@{host}",
    ]
    copy_start = time.monotonic()
    result = subprocess.run(cmd)
    copy_elapsed = time.monotonic() - copy_start
    host_elapsed = time.monotonic() - host_start

    if result.returncode == 0:
        print(f"        OK - key installed in {copy_elapsed:.2f}s (total {host_elapsed:.2f}s)")
        results.append((host, ip, "SUCCESS", host_elapsed))
    else:
        print(f"        FAIL - ssh-copy-id exit {result.returncode} after {copy_elapsed:.2f}s")
        results.append((host, ip, f"FAILED(rc={result.returncode})", host_elapsed))

total_elapsed = time.monotonic() - overall_start
print(f"\n=== Summary ({total_elapsed:.2f}s total) ===")
for host, ip, status, elapsed in results:
    print(f"  {status:20s} {host:18s} {ip:16s} {elapsed:.2f}s")
