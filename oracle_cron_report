#!/usr/bin/env python3

import csv
import io
import subprocess
import smtplib
from datetime import datetime
from email.message import EmailMessage

SSH_USER = "fsalami"

EMAIL_FROM = "fsalami@netspend.com"
EMAIL_TO = ["fsalami@netspend.com"]
SMTP_SERVER = "localhost"
SMTP_PORT = 25

HOSTS = [
    ("10.172.136.141", "p01_teller_nonprod"),
]

CSV_HEADERS = ["timestamp", "server", "ip", "status", "cron_line"]


def check_oracle_cron(ip):
    cmd = [
        "ssh",
        "-o", "BatchMode=yes",
        "-o", "StrictHostKeyChecking=no",
        "-o", "ConnectTimeout=10",
        f"{SSH_USER}@{ip}",
        "sudo su - oracle -c 'crontab -l'",
    ]

    return subprocess.run(
        cmd,
        capture_output=True,
        text=True,
        timeout=40,
    )


def collect_rows():
    timestamp = datetime.now().isoformat(timespec="seconds")
    rows = []

    for ip, name in HOSTS:
        try:
            result = check_oracle_cron(ip)

            if result.returncode == 0:
                cron_output = result.stdout.strip()

                if cron_output:
                    cron_lines = [
                        line for line in cron_output.splitlines()
                        if line.strip() and not line.strip().startswith("#")
                    ]
                    if cron_lines:
                        for line in cron_lines:
                            rows.append([timestamp, name, ip, "MONITORING FOUND", line])
                    else:
                        rows.append([timestamp, name, ip, "NO ACTIVE CRON ENTRIES", ""])
                else:
                    rows.append([timestamp, name, ip, "NO CRONTAB FOUND", ""])

            else:
                err = (result.stderr.strip() or result.stdout.strip()).replace("\n", " | ")
                rows.append([timestamp, name, ip, "FAILED", err])

        except subprocess.TimeoutExpired:
            rows.append([timestamp, name, ip, "TIMEOUT", ""])

        except Exception as e:
            rows.append([timestamp, name, ip, "ERROR", str(e)])

    return rows


def rows_to_csv(rows):
    buf = io.StringIO()
    writer = csv.writer(buf)
    writer.writerow(CSV_HEADERS)
    writer.writerows(rows)
    return buf.getvalue()


def send_email(csv_text, csv_filename, summary_text):
    msg = EmailMessage()
    msg["From"] = EMAIL_FROM
    msg["To"] = ", ".join(EMAIL_TO)
    msg["Subject"] = f"Oracle Crontab Report - {datetime.now().strftime('%Y-%m-%d')}"

    msg.set_content(summary_text)
    msg.add_attachment(
        csv_text.encode("utf-8"),
        maintype="text",
        subtype="csv",
        filename=csv_filename,
    )

    with smtplib.SMTP(SMTP_SERVER, SMTP_PORT) as server:
        server.send_message(msg)


def main():
    rows = collect_rows()
    csv_text = rows_to_csv(rows)

    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    csv_filename = f"oracle_cron_report_{stamp}.csv"
    csv_path = f"/tmp/{csv_filename}"

    with open(csv_path, "w", newline="") as f:
        f.write(csv_text)

    summary_lines = [
        "Oracle Crontab Monitoring Report",
        f"Generated: {datetime.now()}",
        f"Hosts checked: {len(HOSTS)}",
        f"Rows in CSV:   {len(rows)}",
        "",
        "See attached CSV for details.",
    ]
    summary_text = "\n".join(summary_lines)

    send_email(csv_text, csv_filename, summary_text)

    print(f"Report generated: {csv_path}")
    print("Email sent.")


if __name__ == "__main__":
    main()
